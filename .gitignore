# Dependencies are fetched, not committed: `python -m examfig.figdeps` builds
# this directory from a PyPI mirror.  ~214 MB of wheels has no business in git.
python/vendor/

# Local render/preview output.  Anchored with a leading slash: without it,
# `examfig/` also matches the source package `python/examfig/`.
.preview/
.mplcfg/
.mplcache/
tests/.scratch/
/examfig/
*.png
!docs/**/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
pnpm-lock.yaml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Office round-trip leftovers
~$*
.dsh-office-*/
